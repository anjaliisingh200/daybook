# Copy this file to .env.local and fill in the values. Keep .env.local out of git.

# Supabase → Project Settings → API (safe to expose; these two are public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google connection. Server only: never prefix these with NEXT_PUBLIC_.
# Steps to get them are in docs/GOOGLE-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string (32+ characters). It encrypts the saved Google permission. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_TOKEN_KEY=
